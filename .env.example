# --- Telegram (bắt buộc để nhận alert) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Quét ---
SCAN_INTERVAL_SECONDS=60
MIN_QUOTE_VOLUME_USDT=10000      # thấp để quét cả coin vốn hoá nhỏ (spec 005)

# --- Funding arbitrage (mua spot + short perp) ---
FUNDING_MIN_RATE=0.0005          # 0.05% mỗi kỳ
FUNDING_INTERVAL_HOURS=8

# --- Basis spot vs perp ---
BASIS_MIN_PCT=0.02                # 2% (0.5% bị phí ăn hết)
BASIS_ALLOW_REVERSE=false        # chỉ báo Mua Spot + Short Perp
SPOT_TAKER_FEE=0.001             # 0.1% phí taker spot BingX
PERP_TAKER_FEE=0.0005            # 0.05% phí taker perp BingX

# --- So với lịch sử 24h của chính coin (spec 004) ---
BASIS_BASELINE_ENABLED=true
BASIS_MIN_DEVIATION_PCT=0.01     # chỉ báo khi lệch khỏi trung vị 24h >= 1%
BASIS_MIN_ZSCORE=3               # và bất thường >= 3 lần độ dao động thường ngày
BASELINE_INTERVAL=15m
BASELINE_HOURS=24
BASELINE_CACHE_MINUTES=15

# --- Chống spam ---
ALERT_COOLDOWN_MINUTES=30
ALERT_ESCALATION_RATIO=1.5       # báo lại nếu giá trị >= 1.5x lần trước
MAX_ALERTS_PER_MESSAGE=15

# --- Lọc symbol (cách nhau dấu phẩy, ví dụ BTC-USDT,ETH-USDT) ---
SYMBOL_WHITELIST=
SYMBOL_BLACKLIST=

BINGX_BASE_URL=https://open-api.bingx.com

# --- Quản lý channel (spec 002) ---
# User id Telegram được điều khiển bot (cách nhau dấu phẩy).
# Để trống: người đầu tiên nhắn /start cho bot sẽ thành owner.
TELEGRAM_ADMIN_IDS=
TELEGRAM_POLLING=true
DASHBOARD_ENABLED=true
DASHBOARD_INTERVAL_MINUTES=5
STATE_FILE=data/state.json
